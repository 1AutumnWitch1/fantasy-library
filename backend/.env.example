# For local development, copy this file to backend/.env (Java Properties syntax).
# Process environment variables, including those set in IDEA, take precedence.
SERVER_PORT=8080

# Leave all three empty until real Oracle connection details are available.
# URL format: jdbc:oracle:thin:@//HOST:PORT/SERVICE_NAME
ORACLE_JDBC_URL=
ORACLE_USERNAME=
ORACLE_PASSWORD=

# Set true for deployments served over HTTPS. Local Vite development uses HTTP.
AUTH_SECURE_COOKIE=false

# Directory writable by the backend for normalized community images.
# Relative paths are resolved from the backend process working directory.
COMMUNITY_UPLOAD_DIR=./uploads/community

# Folder for game files authorized for distribution. It may be read-only to the backend.
GAME_DOWNLOAD_DIR=./uploads/game-downloads

# Optional private MinIO object storage. Keep disabled until the bucket has been populated.
# Endpoint is the S3 API on port 9000, not the browser console on port 9001.
MEDIA_STORAGE_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=fantasy-library-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
