# Copy to .env.docker at the project root. Keep the actual values local.
# Quote passwords with single quotes so Compose preserves $ and #.
ORACLE_USERNAME=
ORACLE_PASSWORD=''
ORACLE_PWD=''
MINIO_ROOT_USER=libraryadmin
MINIO_ROOT_PASSWORD=''
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=''
MINIO_BUCKET=fantasy-library-media
MINIO_LICENSE_FILE=D:/minio/minio.license

PUBLIC_PORT=5173
ADMIN_PORT=5174
BACKEND_PORT=8080
ORACLE_PORT=11521
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
# Only needed if you change the public or admin website port.
# VITE_PUBLIC_SITE_URL=http://localhost:5173

# Optional mirrors when Docker Hub cannot be reached.
# NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim
# NGINX_IMAGE=mirror.gcr.io/library/nginx:stable-alpine
# ORACLE_IMAGE=container-registry.oracle.com/database/free:latest
